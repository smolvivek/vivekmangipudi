---
import site from '../data/site.json';
interface Props { title?: string; description?: string; nav?: string; image?: string }
const { title, description = 'Vivek Mangipudi is a creative director in Mumbai, moving into marketing and strategy. Films, products and brand work.', nav = '', image = '/img/og.jpg' } = Astro.props;
const full = title ? `${title} · Vivek Mangipudi` : 'Vivek Mangipudi · Creative director';
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = { '@context': 'https://schema.org', '@type': 'Person', name: 'Vivek Mangipudi', jobTitle: 'Creative Director', address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' }, email: site.email, url: Astro.site?.toString(), sameAs: site.socials.map((s) => s.href) };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Vivek Mangipudi" />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={full} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+Devanagari:wght@500&family=Noto+Sans+JP:wght@500&family=JetBrains+Mono:wght@400&display=swap" />
<link rel="stylesheet" href="/styles.css" />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
</head>
<body>
<div class="site">
<header class="top">
<a href="/" style="font-weight:600;">Vivek Mangipudi</a>
<a class="dot" id="dot" href="/contact" aria-label="Open to marketing and strategy roles. Get in touch.">
<svg viewBox="0 0 28 28" aria-hidden="true"><circle class="trk" cx="14" cy="14" r="12"/><circle class="prg" id="prg" cx="14" cy="14" r="12"/><circle class="core" cx="14" cy="14" r="5"/></svg>
<span class="tip"><b>Open to marketing and strategy roles</b><span id="tip-np" hidden></span><em>Say hello →</em></span>
</a>
<nav class="r">
<a href="/work" class={nav === 'work' ? 'on' : ''}>Work</a>
<a href="/photographs" class={nav === 'ph' ? 'on' : ''}>Photographs</a>
<a href="/about" class={nav === 'about' ? 'on' : ''}>About</a>
<a href="/contact" class={nav === 'contact' ? 'on' : ''}>Contact</a>
</nav>
</header>
<main><slot /></main>
<footer class="foot">
<span style="font-size:13px;color:#7A766F;">Open to marketing and strategy roles</span>
<a class="mail" href="/contact">Get in touch</a>
<div class="socs" style="margin-top:8px;">
{site.socials.map((s) => <a class="soc" href={s.href} target="_blank" rel="noopener"><Fragment set:html={s.svg} /><span>{s.name}</span></a>)}
</div>
</footer>
</div>
<script>
const prg = document.getElementById('prg') as unknown as SVGCircleElement | null;
const C = 2 * Math.PI * 12;
if (prg) {
  prg.style.strokeDasharray = String(C);
  const upd = () => { const h = document.documentElement; const max = h.scrollHeight - h.clientHeight; const f = max > 0 ? Math.min(1, Math.max(0, h.scrollTop / max)) : 0; prg.style.strokeDashoffset = String(C * (1 - f)); };
  upd(); addEventListener('scroll', upd, { passive: true }); addEventListener('resize', upd);
}
async function nowPlaying() {
  try {
    const r = await fetch('/api/now-playing');
    if (!r.ok) return;
    const d = await r.json();
    if (!d.track) return;
    const line = `${d.track}, ${d.artist}`;
    const np = document.getElementById('np');
    if (np) {
      document.getElementById('np-track')!.textContent = line;
      document.getElementById('np-label')!.textContent = d.playing ? 'Now playing' : 'Last played';
      (np.querySelector('.eq') as HTMLElement).style.display = d.playing ? '' : 'none';
      np.classList.remove('np-off');
    }
    const tip = document.getElementById('tip-np');
    if (tip) { tip.textContent = `${d.playing ? 'Listening to' : 'Last played'}: ${line}`; tip.hidden = false; }
    document.getElementById('dot')?.classList.toggle('live', !!d.playing);
  } catch {}
}
nowPlaying();
setInterval(nowPlaying, 60000);
</script>
</body>
</html>
