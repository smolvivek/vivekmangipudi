---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const to = encodeURIComponent(site.email);
const subject = encodeURIComponent('Hello from your website');
---
<Base title="Contact" nav="contact" description="Get in touch with Vivek Mangipudi, creative director in Mumbai, open to marketing and strategy roles.">
<div class="ph-head"><h1>Contact</h1><p class="lede g">I’m open to marketing and strategy roles, and to projects where a creative director is useful. Email is the quickest way to reach me.</p></div>
<div class="contact">
<p class="bigmail" id="addr">{site.email}</p>
<div class="actions">
<button type="button" class="more solid" id="copy" data-email={site.email}>Copy address</button>
<a class="more" href={`https://mail.google.com/mail/?view=cm&fs=1&to=${to}&su=${subject}`} target="_blank" rel="noopener">Write in Gmail</a>
<a class="more" href={`https://outlook.live.com/mail/0/deeplink/compose?to=${to}&subject=${subject}`} target="_blank" rel="noopener">Write in Outlook</a>
<a class="more" href={`mailto:${site.email}?subject=${subject}`}>Open mail app</a>
</div>
<p class="note g" id="copied" aria-live="polite">Pick whichever suits you. Copying the address always works.</p>
<div class="facts">
<div><span>Based in</span>Mumbai, India</div>
<div><span>Local time</span><b id="clock">–</b></div>
<div><span>Looking for</span>Marketing and strategy roles</div>
</div>
<div class="socs">{site.socials.map((s) => <a class="soc" href={s.href} target="_blank" rel="noopener"><Fragment set:html={s.svg} /><span>{s.name}</span></a>)}</div>
</div>
<script>
const btn = document.getElementById('copy') as HTMLButtonElement;
const note = document.getElementById('copied')!;
btn.addEventListener('click', async () => {
  const email = btn.dataset.email!;
  try { await navigator.clipboard.writeText(email); }
  catch { const r = document.createRange(); r.selectNodeContents(document.getElementById('addr')!); const s = getSelection()!; s.removeAllRanges(); s.addRange(r); try { document.execCommand('copy'); } catch {} }
  btn.textContent = 'Copied'; note.textContent = 'Address copied. Paste it into any mail app.';
  setTimeout(() => { btn.textContent = 'Copy address'; }, 2200);
});
const clock = document.getElementById('clock')!;
const tick = () => { clock.textContent = new Intl.DateTimeFormat('en-IN', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata', hour12: true }).format(new Date()) + ' IST'; };
tick(); setInterval(tick, 30000);
</script>
</Base>
